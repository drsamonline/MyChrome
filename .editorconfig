# AutoIt source keeps CRLF and tabs; everything else is UTF-8 with LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.au3]
end_of_line = crlf
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

[*.{ps1,yml,yaml,json,md,html,css,js}]
indent_style = space
indent_size = 2

[*.{ini,txt}]
end_of_line = crlf
trim_trailing_whitespace = false
